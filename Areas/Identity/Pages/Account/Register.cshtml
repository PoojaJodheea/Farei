@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/login.cshtml";
}
<div class="auth-page">
    <!-- Left Panel -->
    <div class="auth-left">
        <h1>Create Account</h1>
        <p>Join FAREI to get started.</p>
    </div>

    <!-- Right Panel (Form) -->
    <div class="auth-right">
        <div class="auth-card">
            <h2>Register</h2>
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="Email" />
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Password" />
                    <label asp-for="Input.Password">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Confirm Password" />
                    <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <select asp-for="Input.Type" class="form-control" asp-items="Model.Types">
                        <option value=""></option>
                    </select>
                    <label asp-for="Input.Type">Role</label>
                    <span asp-validation-for="Input.Type" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <select asp-for="Input.Site" class="form-control" asp-items="Model.Sites">
                        <option value=""></option>
                    </select>
                    <label asp-for="Input.Site">Site</label>
                    <span asp-validation-for="Input.Site" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <select asp-for="Input.Supervisor" class="form-control" asp-items="Model.Supervisor">
                        <option value=""></option>
                    </select>
                    <label asp-for="Input.Supervisor">Supervisor</label>
                    <span asp-validation-for="Input.Supervisor" class="text-danger"></span>
                </div>

                <button id="registerSubmit" type="submit" class="btn-primary">Register</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
}
