@model FormRequest.Models.FormReqDb

@{
    ViewData["Title"] = "Repair/Servicing Request Form";
}

<h2>Repair/Servicing Request Form</h2>
<hr />

<form asp-action="Create">
    <h4>Request Details</h4>
    <div class="row mb-3">
        <div class="col-md-3">
            <label asp-for="RequestDate">Date:</label>
            <input asp-for="RequestDate" type="date" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="Site">Site:</label>
            <input asp-for="Site" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="Department">Department:</label>
            <select asp-for="Department" class="form-control">
                <option>-- Select Department --</option>
                <option> IT Dept </option>
                <option> Finance Dept </option>
                <option>HR Dept </option>
                
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="ResponsibleOfficer">Responsible Officer:</label>
            <input asp-for="ResponsibleOfficer" class="form-control" />
        </div>
    </div>
    <div class="form-group mb-4">
        <label asp-for="ContactPhone">Contact Phone:</label>
        <input asp-for="ContactPhone" class="form-control" />
    </div>

    <h4>Equipment Section</h4>
    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Equipment Type</th>
                <th>Serial Number</th>
                <th>Problem</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><input asp-for="EquipmentType" class="form-control" /></td>
                <td><input asp-for="SerialNumber" class="form-control" /></td>
                <td><input asp-for="ProblemDescription" class="form-control" /></td>
            </tr>
        </tbody>
    </table>
    <button type="button" class="btn btn-secondary mb-3">Add Equipment</button>

    <h4>Registry Section</h4>
    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>From</th>
                <th>To</th>
                <th>Date</th>
                <th>Remarks</th>
                <th>Approved</th>
                <th>Invalid</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><input asp-for="From" class="form-control" /></td>
                <td><input asp-for="To" class="form-control" /></td>
                <td><input asp-for="MovementDate" type="date" class="form-control" /></td>
                <td><textarea asp-for="Remarks" class="form-control"></textarea></td>
                <td class="text-center">@Html.CheckBoxFor(m => m.IsApproved)</td>
                <td class="text-center">@Html.CheckBoxFor(m => m.IsInvalid)</td>
            </tr>
        </tbody>
    </table>
    <button type="button" class="btn btn-secondary mb-3">Add Registry Entry</button>

    <div class="form-group">
        <input type="submit" value="Submit" class="btn btn-primary" />
        <input type="reset" value="Cancel" class="btn btn-outline-secondary" />
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
