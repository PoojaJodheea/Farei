@using FormRequest.ViewModel
@model RequestViewModel
@{
    ViewData["Title"] = "Requests";
    Layout = "~/Views/Shared/IttLayout.cshtml";
}

<h1>Technician</h1>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.FormReqDb.Site)</th>
            <th>@Html.DisplayNameFor(m => m.FormReqDb.Department)</th>
            <th>@Html.DisplayNameFor(m => m.FormReqDb.ResponsibleOfficer)</th>
            <th>@Html.DisplayNameFor(m => m.FormReqDb.ProblemDescription)</th>
            <th>@Html.DisplayNameFor(m => m.FormReqDb.SerialNumber)</th>
            <th>@Html.DisplayNameFor(m => m.FormReqDb.status)</th>
            <th>Movement Type</th>
            <th>Details</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.FormReqDbs)
        {
            var statusClass = StatusClass.GetStatusClass(item.status);
            <tr>
                <td>@item.Site</td>
                <td>@item.Department</td>
                <td>@item.ResponsibleOfficer</td>
                <td>@item.ProblemDescription</td>
                <td>@item.SerialNumber</td>
                <td class="@statusClass status-cell" data-id="@item.Id">@item.status</td>
                <td>
                    @if (item.Pointer == 1)
                    {
                        <form asp-action="ChangeStatus" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="Status" value="3" />
                            <button type="submit" class="btn btn-sm btn-secondary">Onsite</button>
                        </form>
                        <form asp-action="ChangeStatus" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="Status" value="4" />
                            <button type="submit" class="btn btn-sm btn-warning">Transit</button>
                        </form>
                    }
                </td>
                <td>
                    <a asp-action="TechnicianDetailsForm" asp-route-id="@item.Id" class="btn btn-sm btn-B">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
