    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.FormReqDb.Id">Edit</a> |
  
</div>

<h3>Add Registry Entry</h3>

<form asp-action="SubmitRegistry" method="post">
    @Html.AntiForgeryToken()

    <input asp-for="Registry.FormReqDbId" type="hidden" />

    <div>
        <label asp-for="Registry.From"></label>
        <input asp-for="Registry.From" class="form-control" />
        <span asp-validation-for="Registry.From" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Registry.To"></label>
        <input asp-for="Registry.To" class="form-control" />
        <span asp-validation-for="Registry.To" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Registry.MovementDate"></label>
        <input asp-for="Registry.MovementDate" type="date" class="form-control" />
        <span asp-validation-for="Registry.MovementDate" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Registry.Remarks"></label>
        <textarea asp-for="Registry.Remarks" class="form-control"></textarea>
        <span asp-validation-for="Registry.Remarks" class="text-danger"></span>
    </div>

    <div>
        <input asp-for="Registry.IsValid" class="form-check-input" />
        <label asp-for="Registry.IsValid" class="form-check-label"></label>
    </div>

    <div>
        <input asp-for="Registry.IsOnSite" class="form-check-input" />
        <label asp-for="Registry.IsOnSite" class="form-check-label"></label>
    </div>

    <div>
        <input asp-for="Registry.IsInTransit" class="form-check-input" />
        <label asp-for="Registry.IsInTransit" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Submit</button>
</form>


<div class="mt-3">
    <a asp-action="Registry" class="btn btn-secondary">Back to List</a>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
