@using FormRequest.ViewModel
@model RequestViewModel
@{
    ViewData["Title"] = "Requests";
    Layout = "~/Views/Shared/Registrylayout.cshtml";
}


<div>
    <h4>Registry Details</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FormReqDb.RequestDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FormReqDb.RequestDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FormReqDb.Site)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FormReqDb.Site)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FormReqDb.Department)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FormReqDb.Department)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FormReqDb.ResponsibleOfficer)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FormReqDb.ResponsibleOfficer)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FormReqDb.ContactPhone)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FormReqDb.ContactPhone)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FormReqDb.EquipmentType)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FormReqDb.EquipmentType)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FormReqDb.ProblemDescription)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FormReqDb.ProblemDescription)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FormReqDb.SerialNumber)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FormReqDb.SerialNumber)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FormReqDb.Supervisor)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FormReqDb.Supervisor)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FormReqDb.status)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FormReqDb.status)
        </dd>
    </dl>
</div>
<div>
    <form asp-action="SubmitRegistry" method="post">
        <input asp-for="Registry.FormReqDbId" value="@Model.FormReqDb.Id" type="hidden" />
        <div>
            <label asp-for="Registry.Remarks"></label>
            <textarea asp-for="Registry.Remarks" class="R-textbox" class="form-control"></textarea>
            <span asp-validation-for="Registry.Remarks" class="text-danger"></span>            
        </div>
        <div>
            <label>Time</label>
            <input asp-for="Registry.DateReceived" class="R-textbox" class="form-control" />
        </div>
        <div>
            <label>Driver</label>
            <input asp-for="Registry.Driver" class="R-textbox" class="form-control" />
        </div>


<button type="submit" class="btn btn-primary mt-3 btn-H">Submit</button>
    </form>
    <a asp-action="Registry">Back to List</a>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    
   
}