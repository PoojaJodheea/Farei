@using FormRequest.ViewModel
@model RequestViewModel
@{
    ViewData["Title"] = "Requests";
    Layout = "~/Views/Shared/Registrylayout.cshtml";
}

<div class="container">
    <div class="row">
        <!-- Request Info -->
        <div class="col-md-6 border-end pe-4">
            <h4>Request Details</h4>
            <dl class="row">
                <dt>Request Date</dt>
                <dd>@Model.FormReqDb.RequestDate.ToShortDateString()</dd>

                <dt>Site</dt>
                <dd>@Model.FormReqDb.Site</dd>

                <dt>Department</dt>
                <dd>@Model.FormReqDb.Department</dd>

                <dt>Responsible Officer</dt>
                <dd>@Model.FormReqDb.ResponsibleOfficer</dd>

                <dt>Contact Phone</dt>
                <dd>@Model.FormReqDb.ContactPhone</dd>
            </dl>
        </div>

        <!-- Equipment Info -->
        <div class="col-md-6 ps-4">
            <h4>Equipment Details</h4>
            <dl class="row">
                <dt>Equipment Type</dt>
                <dd>@Model.FormReqDb.EquipmentType</dd>

                <dt>Serial Number</dt>
                <dd>@Model.FormReqDb.SerialNumber</dd>


                <dt>Problem Description</dt>
                <dd>@Model.FormReqDb.ProblemDescription</dd>
            </dl>
        </div>
    </div>
</div>


<div>
    <form asp-action="SubmitRegistry" method="post">
        <input asp-for="Registry.FormReqDbId" value="@Model.FormReqDb.Id" type="hidden" />
        <div>
            <label asp-for="Registry.Remarks"></label>
            <textarea asp-for="Registry.Remarks" class="R-textbox" class="form-control"></textarea>
            <span asp-validation-for="Registry.Remarks" class="text-danger"></span>            
        </div>
        <div>
            <label>Time</label>
            <input asp-for="Registry.DateReceived" class="R-textbox" class="form-control" 
            max="@DateTime.Now.ToString("yyyy-MM-dd")"
                   value="@DateTime.Now.ToString("yyyy-MM-dd")" />
        </div>
        <div>
            <label>Driver</label>
            <input asp-for="Registry.Driver" class="R-textbox" class="form-control" />
        </div>


<button type="submit" class="btn btn-primary mt-3 btn-H">Submit</button>
    </form>
    <a asp-action="Registry">Back to List</a>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    
   
}