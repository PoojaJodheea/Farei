@model IEnumerable<FormRequest.Models.FormReqDb>

@{
    ViewData["Title"] = "On-Site Requests";
}

<h2>On-Site Requests</h2>
<div class="mb-3">
    <a asp-action="Registry" class="btn btn-secondary">All Requests</a>
    <a asp-action="OnSite" class="btn btn-success">On-Site</a>
    <a asp-action="InTransit" class="btn btn-warning">In Transit</a>
</div>


<table class="table table-striped table-bordered">
    <thead class="table-light">
        <tr>
            <th>Site</th>
            <th>Department</th>
            <th>Officer</th>
            <th>Equipment</th>
            <th>Serial No.</th>
            <th>Problem Decription</th>
            <th>Remarks</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var OnSiteRegistry = item.Registries
            .Where(r => r.IsOnSite)
            
            .FirstOrDefault();

            if (OnSiteRegistry != null)
            {
                string faded = OnSiteRegistry.IsValid ? "style='opacity: 0.5;'" : "";
                <tr Html.Raw(faded)>
                    
                
                    <td>@item.Site</td>
                    <td>@item.Department</td>
                    <td>@item.ResponsibleOfficer</td>
                    <td>@item.EquipmentType</td>
                    <td>@item.SerialNumber</td>
                    <td>@item.ProblemDescription</td>
                    <td>@OnSiteRegistry.Remarks</td>
                  
                    <td>
                        <form asp-action="DeleteRegistry" asp-route-registryId="@OnSiteRegistry.RegistryId" method="post" onsubmit="return confirm('Are you sure you want to delete this entry?');" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm">🗑 Delete</button>
                        </form>
                        >


                    </td>

                </tr>
            }
        }
    </tbody>
</table>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    

}
