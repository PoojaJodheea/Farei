@model IEnumerable<FormRequest.Models.FormReqDb>

@{
    ViewData["Title"] = "On-Site Requests";
}

<h2>On-Site Requests</h2>
<div class="mb-3">
    <a asp-action="Registry" class="btn btn-secondary">All Requests</a>
    <a asp-action="OnSite" class="btn btn-success">On-Site</a>
    <a asp-action="InTransit" class="btn btn-warning">In Transit</a>
</div>


<table class="table table-striped table-bordered">
    <thead class="table-light">
        <tr>
            <th>Site</th>
            <th>Department</th>
            <th>Officer</th>
            <th>Equipment</th>
            <th>Serial No.</th>
            <th>Problem Decription</th>
            <th>Remarks</th>
            <th>Acknowledgement</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var OnSiteRegistry = item.Registries
            .Where(r => r.IsOnSite)
            
            .FirstOrDefault();

            if (OnSiteRegistry != null)
            {
                string faded = OnSiteRegistry.IsValid ? "style='opacity: 0.5;'" : "";
                <tr Html.Raw(faded)>
                    
                
                    <td>@item.Site</td>
                    <td>@item.Department</td>
                    <td>@item.ResponsibleOfficer</td>
                    <td>@item.EquipmentType</td>
                    <td>@item.SerialNumber</td>
                    <td>@item.ProblemDescription</td>
                    <td>@OnSiteRegistry.Remarks</td>
                    <td>
                        @if (!OnSiteRegistry.IsValid)
                        {
                            <form asp-action="AcknowledgeRequest" method="post">
                                <input type="hidden" name="id" value="@OnSiteRegistry.RegistryId" />
                                <button class="btn btn-sm btn-success" type="submit">✔ Acknowledge</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted">✔ Acknowledged</span>
                        }
                    </td>
                    <td>
                        <form method="post" asp-action="DeleteRegistry" onsubmit="return confirmDelete(@(OnSiteRegistry.IsValid.ToString().ToLower()))">
                            <input type="hidden" name="id" value="@OnSiteRegistry.RegistryId" />
                            <button type="submit" class="btn btn-danger btn-sm">🗑 Delete</button>
                        </form>


                    </td>

                </tr>
            }
        }
    </tbody>
</table>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        function confirmDelete(isValid) {
            if (!isValid) {
                return confirm("⚠️ You haven’t acknowledged this request. Are you sure you want to delete it?");
            }
            return confirm("Are you sure you want to delete this request?");
        }
    </script>

}
