@using FormRequest.ViewModel
@model IEnumerable<FormRequest.ViewModel.RequestViewModel>


@{
	ViewData["Title"] = "All Requests";

}
<link rel="stylesheet" href="~/css/ITO.css" />

<h2 class="page-title">All Requests</h2>

<table class="table table-bordered table-striped" id="requestTable">
	<thead class="purple-table-header">
		<tr>
			<th>Date</th>
			<th>Site</th>
			<th>Department</th>
			<th>Equipment</th>
		
			<th>Problem</th>
			<th>Technician Remark</th>
			<th>Status</th>
			<th>Confirm Movement Type</th>
			<th>Details</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			var status = item.FormReqDb.status?.Trim().ToLower();
			var statusClass = StatusClass.GetStatusClass(item.FormReqDb.status);

			<tr id="row-@item.FormReqDb.Id">
				<td>@item.FormReqDb.RequestDate.ToShortDateString()</td>
				<td>@item.FormReqDb.Site</td>
				<td>@item.FormReqDb.Department</td>
				<td>@item.FormReqDb.EquipmentType</td>
				<td>@item.FormReqDb.ProblemDescription</td>
				<td>@(item.ITTreport?.Report ?? item.FormReqDb?.remarks)</td>

				<td class="@statusClass status-cell" data-id="@item.FormReqDb.Id">@item.FormReqDb.status</td>
				<td>
					@if (status == "transit request" || status == "final request" || status == "onsite request" || status == "transitting" || status == "reject" || status == "accept onsite" || status == "reject onsite" || status == "pending request")
					{
						<button class="btn btn-sm btn-success action-btn accept-btn" data-id="@item.FormReqDb.Id" data-action="accept" @(status.Contains("accept") ? "disabled" : "")>Accept</button>
						<button class="btn btn-sm btn-danger action-btn reject-btn" data-id="@item.FormReqDb.Id" data-action="reject" @(status.Contains("reject") ? "disabled" : "")>Reject</button>
					}
				</td>
				<td>
					<a asp-action="Details" asp-route-id="@item.FormReqDb.Id" class="btn btn-sm btn-purple">Details</a>
				</td>
			</tr>
		}
	</tbody>
</table>
