﻿@using FormRequest.ViewModel
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@model RequestViewModel
@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/SupervisorLayout.cshtml";
}
<div>
    <h4>Request Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.FormReqDb.RequestDate)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FormReqDb.RequestDate)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.FormReqDb.Site)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FormReqDb.Site)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.FormReqDb.Department)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FormReqDb.Department)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.FormReqDb.ResponsibleOfficer)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FormReqDb.ResponsibleOfficer)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.FormReqDb.ContactPhone)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FormReqDb.ContactPhone)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.FormReqDb.EquipmentType)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FormReqDb.EquipmentType)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.FormReqDb.ProblemDescription)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FormReqDb.ProblemDescription)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.FormReqDb.SerialNumber)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FormReqDb.SerialNumber)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.FormReqDb.status)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FormReqDb.status)</dd>
    </dl>
</div>
<div class="form-group">


    @if (Model.FormReqDb.status == "pending" || Model.FormReqDb.status == "accept" || Model.FormReqDb.status == "reject")
{
    <button class="btn btn-sm btn-success action-btn accept-btn"
            data-id="@Model.FormReqDb.Id"
            data-action="accept"
            @(Model.FormReqDb.status.Contains("accept") ? "disabled" : "")>Accept</button>

    <button class="btn btn-sm btn-danger action-btn reject-btn"
            data-id="@Model.FormReqDb.Id"
            data-action="reject"
            @(Model.FormReqDb.status.Contains("reject") ? "disabled" : "")>Reject</button>
}

</div>
