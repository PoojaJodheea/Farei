﻿@using FormRequest.ViewModel
@model RequestViewModel
<head>
    <link rel="stylesheet" href="~/css/User.css" />
</head>
<partial name="Navbar"></partial>
<div class="container">
    <h1>My Request</h1>
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.FormReqDb.RequestDate)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FormReqDb.ResponsibleOfficer)
                </th>


                <th>
                    @Html.DisplayNameFor(model => model.FormReqDb.ProblemDescription)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FormReqDb.status)
                </th>

                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.FormReqDbs)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.RequestDate)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ResponsibleOfficer)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.ProblemDescription)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.status)
                    </td>
                    <td>

                        <a asp-action="Details" asp-route-id="@item.Id">Details</a>

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>