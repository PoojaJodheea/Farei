@model IEnumerable<FormRequest.Models.FormReqDb>

@{
    ViewData["Title"] = "Request Feedback";
    Layout = "~/Views/Shared/User.cshtml";
}

<h2>Request Feedback</h2>

<table class="table table-striped">
    <thead class ="table-header th">
        <tr>
            <th>Date</th>
            <th>Site</th>
            <th>Equipment</th>
            <th>Problem</th>
            <th>Status</th>
            <th>Feedback</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
            var status = item.status?.Trim().ToLower();
            var statusClass = StatusClass.GetStatusClass(item.status);
    <tr>
        <td>@item.RequestDate.ToShortDateString()</td>
        <td>@item.Site</td>
        <td>@item.EquipmentType</td>
        <td>@item.ProblemDescription</td>
        <td class="@statusClass">
    @((status?.Length > 0) 
        ? char.ToUpper(status[0]) + status.Substring(1) 
        : "")
</td>
 <!--to show status repaired/closed-->
        <td>
            @if (string.IsNullOrEmpty(item.UserFeedback))
            {
                <button class="btn btn-sm btn-outline-primary" onclick="toggleFeedbackForm(@item.Id)">➕ Add</button>
            }
            else
            {
                <div>@item.UserFeedback</div>
                @if (!item.IsClosed)
                {
                    <!--edit option only when status is not closed-->
                    <button class="btn btn-sm btn-outline-secondary" onclick="toggleFeedbackForm(@item.Id)">✏️ Edit</button>
                }
            }
        </td>
    </tr>

    <tr id="feedback-form-@item.Id" style="display: none;">  <!--Hidden row shown only when button is clicked-->
        <td colspan="6">
            <form asp-action="SubmitFeedback" method="post" class="row g-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@item.Id" />

                <div class="col-md-8">
                    <textarea name="feedback" class="form-control" placeholder="Enter feedback...">@item.UserFeedback</textarea>
                </div>

                <div class="col-md-2">
                    <div class="form-check">
                       <input type="checkbox" name="confirmRepaired" value="true" class="form-check-input" />
                        <label class="form-check-label">Confirm Repair</label>
                    </div>
                </div>

                <div class="col-md-2 text-end">
                    <button type="submit" class="btn btn-success btn-sm">Submit</button>
                </div>
            </form>
        </td>
    </tr>
}
    </tbody>
</table>

@section Scripts {
    <script>
        function toggleFeedbackForm(id) {  //hides and shows form when clicked
            const formRow = document.getElementById("feedback-form-" + id);
            formRow.style.display = (formRow.style.display === "none") ? "table-row" : "none"; 
        }
    </script>
}
