@model FormRequest.Models.FormReqDb 
@{
    ViewData["Title"] = "Repair/Servicing Request Form";
}

<h2>Repair/Servicing Request Form</h2>
<hr />

<form asp-action="Create" asp-controller="FormReqDb" method="post">
    <h4>Request Details</h4>
    <div class="row mb-3">
        <div class="col-md-3">
            <label asp-for="RequestDate">Date:</label>
            <input asp-for="RequestDate" type="date" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="Site">Site:</label>
            <input asp-for="Site" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="Department">Department:</label>
            <select asp-for="Department" class="form-control">
                <option>-- Select Department --</option>
                <option> IT Dept </option>
                <option> Finance Dept </option>
                <option>HR Dept </option>
                
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="ResponsibleOfficer">Responsible Officer:</label>
            <input asp-for="ResponsibleOfficer" class="form-control" />
        </div>
    </div>
    <div class="form-group mb-4">
        <label asp-for="ContactPhone">Contact Phone:</label>
        <input asp-for="ContactPhone" class="form-control" />
    </div>
    <div class="form-group mb-4">
        <label asp-for="Supervisor">Supervisor:</label>
        <input asp-for="Supervisor" class="form-control" />
    </div>

    <h4>Equipment Section</h4>
    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Equipment Type</th>
                <th>Serial Number</th>
                <th>Problem</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><input asp-for="EquipmentType" class="form-control" /></td>
               <td>
                   <select asp-for="SerialNumber" class="form-control" id="SerialNumber">
                    <option value="">-- Select Serial Number --</option>
                        <span asp-validation-for="SerialNumber" class="text-danger"></span>
                   </select>
               </td>

                <td><input asp-for="ProblemDescription" class="form-control" /></td>
            </tr>
        </tbody>
    </table>
    <button type="button" class="btn btn-secondary mb-3">Add Equipment</button>

    <input type="hidden" id="IsDraft" name="IsDraft" value="false" />
    

    <div class="form-group">
       <button type="submit" class="btn btn-primary">Submit</button>
   
    <input type="reset" value="Cancel" class="btn btn-outline-secondary" />
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        function fetchSerialNumbers() {
            var site = $('#Site').val();
            var department = $('#Department').val();
            var equipmentType = $('input[name="EquipmentType"]').val(); // assuming it's a text input

            if (site && department && equipmentType) {
                $.ajax({
                    url: '@Url.Action("GetSerialNumbers", "FormReqDb")', 
                    data: {
                        site: site,
                        department: department,
                        equipmentType: equipmentType
                    },
                    success: function (data) {
                        var serialDropdown = $('#SerialNumber');
                        serialDropdown.empty();
                        serialDropdown.append($('<option>', { value: '', text: '-- Select Serial Number --' }));
                        $.each(data, function (i, val) {
                            serialDropdown.append($('<option>', { value: val, text: val }));
                        });
                    }
                });
            }
        }

        // Trigger when any of the 3 inputs change
        $('#Site, #Department, input[name="EquipmentType"]').on('change keyup', function () {
            fetchSerialNumbers();
        });
    </script>


}
