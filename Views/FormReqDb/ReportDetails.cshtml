current cshtml:@using FormRequest.ViewModel
@model RequestViewModel

<head>
    <link rel="stylesheet" href="~/css/ITT.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

    <!-- jQuery (required by DataTables) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>


    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css" />
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

    <!-- JSZip for Excel Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
</head>
<partial name="Navbar" />

<div class="container">
    <h3 class="mt-3">Request and Equipment Details</h3>


    <table class="table" id="dataTable">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.FormReqDb.RequestDate)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FormReqDb.Site)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FormReqDb.Department)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FormReqDb.ResponsibleOfficer)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FormReqDb.ContactPhone)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FormReqDb.ProblemDescription)
                </th>



                <th>

                    @Html.DisplayNameFor(model => model.FormReqDb.Equipments.SerialNumber)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FormReqDb.Equipments.EquipmentType)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FormReqDb.Equipments.EquipmentName)
                </th>



                <th>

                    @Html.DisplayNameFor(model => model.Registry.From)
                </th>

                <th>

                    @Html.DisplayNameFor(model => model.Registry.To)
                </th>

                <th>

                    @Html.DisplayNameFor(model => model.Registry.Driver)
                </th>
                <th>

                    @Html.DisplayNameFor(model => model.Registry.Remarks)
                </th>

            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.FormReqDbs)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(model => item.RequestDate)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Site)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Department)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.ResponsibleOfficer)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.ContactPhone)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.ProblemDescription)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Equipments.SerialNumber)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Equipments.EquipmentType)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Equipments.EquipmentName)
                    </td>
                    <td>
                        @(item.Registries?.FirstOrDefault()?.From ?? "No Registry Data")
                    </td>

                    <td>
                        @(item.Registries?.FirstOrDefault()?.To ?? "No Registry Data")
                    </td>
                    <td>
                        @(item.Registries?.FirstOrDefault()?.Driver ?? "No Registry Data")
                    </td>

                    <td> 
                        @(item.Registries?.FirstOrDefault()?.Remarks ?? "No Registry Data")
                    </td>

                </tr>
            }

        </tbody>
    </table>

</div>

