@model IEnumerable<FormRequest.Models.FormReqDb>

@{
    ViewData["Title"] = "Index";
}

<h1>Repair / Servicing Requests</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.RequestDate)</th>
            <th>@Html.DisplayNameFor(model => model.ResponsibleOfficer)</th>
            <th>@Html.DisplayNameFor(model => model.EquipmentType)</th>
            <th>@Html.DisplayNameFor(model => model.ProblemDescription)</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.RequestDate)</td>
                <td>@Html.DisplayFor(modelItem => item.ResponsibleOfficer)</td>
                <td>@Html.DisplayFor(modelItem => item.EquipmentType)</td>
                <td>@Html.DisplayFor(modelItem => item.ProblemDescription)</td>
                <td>
                    @if (item.IsDraft)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="badge bg-warning text-dark" title="Click to complete draft">Draft</a>
                    }
                    else
                    {
                        <span class="badge bg-success">Pending</span>
                    }
                </td>
                <td>
                    
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
