@using FormRequest.Models

@model IEnumerable<FormRequest.Models.FormReqDb>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/User.cshtml";
}

<h1>Repair / Servicing Requests</h1>

<p>
    <a asp-action="Create" class="btn btn-primary btn-H">Create New</a>
</p>

<table class="table table-striped">
    <thead class ="table-header th">
        <tr>
            <th>@Html.DisplayNameFor(model => model.RequestDate)</th>
            <th>@Html.DisplayNameFor(model => model.ResponsibleOfficer)</th>
            <th>@Html.DisplayNameFor(model => model.EquipmentType)</th>
            <th>@Html.DisplayNameFor(model => model.ProblemDescription)</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var status = item.status?.Trim().ToLower();
            var statusClass = StatusClass.GetStatusClass(item.status);
            <tr>
                <td>@Html.DisplayFor(modelItem => item.RequestDate)</td>
                <td>@Html.DisplayFor(modelItem => item.ResponsibleOfficer)</td>
                <td>@Html.DisplayFor(modelItem => item.EquipmentType)</td>
                <td>@Html.DisplayFor(modelItem => item.ProblemDescription)</td>
              
                <td class="status-cell @statusClass" data-id="@item.Id">
                    @if (item.IsDraft)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="text-warning">Draft</a>
                    }
                    else
                    {
                        @item.status
                    }
                </td>

                <td>

                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-H">Details</a> 
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-H">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<form asp-action="SetFeedbackLimit" method="post">
    <div class="form-group">
        <label>Enter Number of Days Limit to submit Feedback:</label>
        <input type="number" name="days" class="form-control" min="1" value="@Model" required />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Save Limit</button>
</form>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success mt-2">@TempData["Message"]</div>
}

