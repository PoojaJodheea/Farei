@model IEnumerable<FormRequest.ViewModel.RequestViewModel>
@{
    ViewData["Title"] = "NewComponent";
    Layout = "~/Views/Shared/ITOlayout.cshtml";
}

<h2>New Component</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Date</th>
            <th>Technician</th>
            <th>Equipment Type</th> 
            <th>Problem</th>
            <th>Remark</th>
            <th>Details</th>
           

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {

            <tr>


                <td>@item.Registry.DateReceived.ToShortDateString()</td>

                <td>@item.FormReqDb.Technician</td>
                <td>@item.FormReqDb.EquipmentType</td>
                <td>@item.FormReqDb.ProblemDescription</td>
                <td>@item.Registry.Remarks</td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.FormReqDb.Id" class="btn btn-outline-primary btn-sm">
                        Details
                    </a>
                </td>
            </tr>
           

        }
    </tbody>
</table>


@section Scripts {
   
}