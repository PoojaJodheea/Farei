@model List<FormRequest.ViewModel.RegistryViewModel>

@{
    ViewData["Title"] = "Registry Dashboard";
   
}

<h2>Registry Dashboard</h2>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link active" data-bs-toggle="tab" href="#requests">Requests</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#onsite">On Site</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#transit">In Transit</a>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="requests">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Officer</th>
                    <th>Equipment</th>
                    <th>Problem</th>
                    <th>Registry</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.FormReqDb.RequestDate.ToShortDateString()</td>
                        <td>@item.FormReqDb.ResponsibleOfficer</td>
                        <td>@item.FormReqDb.EquipmentType</td>
                        <td>@item.FormReqDb.ProblemDescription</td>
                        <td>
                            <button class="btn btn-outline-primary btn-sm" data-bs-toggle="collapse" data-bs-target="#regForm-@item.FormReqDb.Id">
                                ➕ Add
                            </button>

                            <div id="regForm-@item.FormReqDb.Id" class="collapse mt-2">
                                <form asp-action="SubmitRegistry" method="post">
                        

                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="FormReqDbId" value="@item.FormReqDb.Id" />

                                    <div class="row mb-2">
                                        <div class="col">
                                            <input name="From" class="form-control" placeholder="From" />
                                        </div>
                                        <div class="col">
                                            <input name="To" class="form-control" placeholder="To" />
                                        </div>
                                        <div class="col">
                                            <input name="MovementDate" type="date" class="form-control" />
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="col">
                                            <input name="Remarks" class="form-control" placeholder="Remarks" />
                                        </div>
                                        <div class="col form-check">
                                            <input type="checkbox" name="IsValid" class="form-check-input" id="valid-@item.FormReqDb.Id" />
                                            <label class="form-check-label" for="valid-@item.FormReqDb.Id">Valid</label>
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="col form-check">
                                            <input type="checkbox" name="IsOnSite" class="form-check-input" id="onsite-@item.FormReqDb.Id" />
                                            <label class="form-check-label" for="onsite-@item.FormReqDb.Id">On Site</label>
                                        </div>
                                        <div class="col form-check">
                                            <input type="checkbox" name="IsInTransit" class="form-check-input" id="transit-@item.FormReqDb.Id" />
                                            <label class="form-check-label" for="transit-@item.FormReqDb.Id">In Transit</label>
                                        </div>
                                        <div class="col">
                                            <button type="submit" class="btn btn-success btn-sm">Submit</button>
                                        </div>
                                    </div>
                                </form>
                                

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- On Site Tab -->
    <div class="tab-pane fade" id="onsite" role="tabpanel" aria-labelledby="onsite-tab">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Officer</th>
                    <th>Equipment</th>
                    <th>Problem</th>
                    <th>Movement Date</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    if (item.RegistryList != null)
                    {
                        foreach (var reg in item.RegistryList.Where(r => r.IsOnSite))
                        {
                            <tr>
                                <td>@item.FormReqDb.RequestDate.ToShortDateString()</td>
                                <td>@item.FormReqDb.ResponsibleOfficer</td>
                                <td>@item.FormReqDb.EquipmentType</td>
                                <td>@item.FormReqDb.ProblemDescription</td>
                                <td>@reg.MovementDate.ToShortDateString()</td>
                                <td>@reg.Remarks</td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- In Transit Tab -->
    <div class="tab-pane fade" id="transit" role="tabpanel" aria-labelledby="transit-tab">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Officer</th>
                    <th>Equipment</th>
                    <th>Problem</th>
                    <th>Movement Date</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    if (item.RegistryList != null)
                    {
                        foreach (var reg in item.RegistryList.Where(r => r.IsInTransit))
                        {
                            <tr>
                                <td>@item.FormReqDb.RequestDate.ToShortDateString()</td>
                                <td>@item.FormReqDb.ResponsibleOfficer</td>
                                <td>@item.FormReqDb.EquipmentType</td>
                                <td>@item.FormReqDb.ProblemDescription</td>
                                <td>@reg.MovementDate.ToShortDateString()</td>
                                <td>@reg.Remarks</td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}