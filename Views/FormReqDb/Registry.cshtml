@model FormRequest.ViewModel.RequestViewModel
@{
    ViewData["Title"] = "Requests";
    Layout = "~/Views/Shared/Registrylayout.cshtml";
}
<h2>Registry - All Requests</h2>

<table class="table table-bordered table-striped">
    <thead class="Brown-table-header">
        <tr>
            <th>Date</th>
            <th>Officer</th>
            <th>Equipment</th>
            <th>Problem</th>
            <th>Status</th>
            <th></th>

        </tr>
    </thead>
    <tbody>
        @foreach (var req in Model.FormReqDbs)
        {
            var status = req.status?.Trim().ToLower();
            var statusClass = StatusClass.GetStatusClass(req.status);
            <tr>
                <td>@req.RequestDate.ToShortDateString()</td>
                <td>@req.ResponsibleOfficer</td>
                <td>@req.EquipmentType</td>
                <td>@req.ProblemDescription</td>
                <td class ="status-cell @statusClass" data-id="@req.Id">@req.status</td>

                <td>
                 
                    <a asp-action="RegistryDetails" asp-route-id="@req.Id" class="btn btn-sm btn-H">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
