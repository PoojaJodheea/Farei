@model IEnumerable<FormRequest.Models.FormReqDb>

@{
    ViewData["Title"] = "Registry Dashboard";
}

<h2>Registry Requests</h2>


<div class="mb-3">
    <a asp-action="Registry" class="btn btn-secondary">All Requests</a>
    <a asp-action="OnSite" class="btn btn-success">On-Site</a>
    <a asp-action="InTransit" class="btn btn-warning">In Transit</a>
</div>


<table class="table table-bordered">
    <thead>
        <tr>
            <th>Date</th>
            <th>Officer</th>
            <th>Equipment</th>
            <th>Problem</th>
            <th>Details</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.RequestDate.ToShortDateString()</td>
                <td>@item.ResponsibleOfficer</td>
                <td>@item.EquipmentType</td>
                <td>@item.ProblemDescription</td>
               
                <td>
                    <a asp-action="RegistryDetails" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                        Details
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
