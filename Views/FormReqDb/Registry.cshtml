@model FormRequest.ViewModel.RequestViewModel

@{
    ViewData["Title"] = "Registry Dashboard";
}

<h2>Registry</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Date</th>
            <th>Site</th>
            <th>Department</th>
            <th>Equipment</th>
            <th>Problem</th>
            <th>Officer</th>
            <th>Technician</th>
            <th>Confirm Transit</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var req in Model.FormReqDbs)
        {
            <tr>
                <td>@req.RequestDate.ToShortDateString()</td>
                <td>@req.Site</td>
                <td>@req.Department</td>
                <td>@req.EquipmentType</td>
                <td>@req.ProblemDescription</td>
                <td>@req.ResponsibleOfficer</td>
                <td>@req.Technician</td>
                <td>
                    <form asp-action="RegistryConfirmation" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="formReqId" value="@req.Id" />
                        <div class="d-flex align-items-center gap-2">
                            <input type="text" name="driver" class="form-control form-control-sm" placeholder="Driver" required />
                            <input type="date" name="dateReceived" class="form-control form-control-sm" required />
                            <button type="submit" class="btn btn-sm btn-success">Valid</button>
                        </div>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
