@model IEnumerable<FormRequest.Models.FormReqDb>

@{
    ViewData["Title"] = "All Requests";
    Layout = "~/Views/Shared/ITOlayout.cshtml";
}

<h2 class="page-title">All Requests</h2>

<table class="table table-bordered table-striped" id="requestTable">
    <thead class="purple-table-header">
        <tr>
            <th>Date</th>
            <th>Site</th>
            <th>Department</th>
            <th>Equipment</th>
            <th>Problem</th>
            <th>Status</th>
            <th>Confirm Movement Type</th>
            <th>Details</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var status = item.status?.Trim().ToLower();
            string statusClass = status switch
            {
                "accepted" => "table-accept",
                "reject" => "table-reject",
                "transit" => "table-pending",
                "onsite" => "table-pending",
                "accept transit" => "table-accept-transit",
                "reject transit" => "table-reject-transit",
                "accept onsite" => "table-accept-onsite",
                "reject onsite" => "table-reject-onsite",
                "complete" => "table-complete",
                "repairing" => "table-repairing",
                "send back" => "table-sendback",
                _ => "table-pending"
            };

            <tr id="row-@item.Id">
                <td>@item.RequestDate.ToShortDateString()</td>
                <td>@item.Site</td>
                <td>@item.Department</td>
                <td>@item.EquipmentType</td>
                <td>@item.ProblemDescription</td>
                <td class="@statusClass status-cell" data-id="@item.Id">@item.status</td>
                <td>
                    @if (status == "transit" || status == "onsite" || status == "accept transit" || status == "reject transit" || status == "accept onsite" || status == "reject onsite")
                    {
                        <button class="btn btn-sm btn-success action-btn accept-btn" data-id="@item.Id" data-action="accept" @(status.Contains("accept") ? "disabled" : "")>Accept</button>
                        <button class="btn btn-sm btn-danger action-btn reject-btn" data-id="@item.Id" data-action="reject" @(status.Contains("reject") ? "disabled" : "")>Reject</button>
                    }

                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-purple">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>


@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).on("click", ".action-btn", function () {
            var id = $(this).data("id");
            var action = $(this).data("action");
            var button = $(this);

            if (!confirm("Are you sure you want to " + action + " this request?")) return;

            $.ajax({
                url: '@Url.Action("UpdateStatus", "FormReqDb")',
                type: 'POST',
                data: { id: id, actionType: action },
                success: function (response) {
                    if (response.success) {
                        var statusCell = $(".status-cell[data-id='" + id + "']");
                        var newStatus = response.newStatus.toLowerCase().trim();

                        var statusClassMap = {
                            "accepted": "table-accept",
                            "reject": "table-reject",
                            "transit": "table-pending",
                            "onsite": "table-pending",
                            "accept transit": "table-accept-transit",
                            "reject transit": "table-reject-transit",
                            "accept onsite": "table-accept-onsite",
                            "reject onsite": "table-reject-onsite",
                            "complete": "table-complete",
                            "repairing": "table-repairing",
                            "send back": "table-sendback"
                        };


                        var newClass = statusClassMap[newStatus] || "table-pending";

                        statusCell.removeClass().addClass("status-cell " + newClass).text(response.newStatus);

                        var row = $("#row-" + id);
                        row.find(".accept-btn").prop("disabled", newStatus.includes("accept"));
                        row.find(".reject-btn").prop("disabled", newStatus.includes("reject"));
                    } else {
                        alert(response.message || "Something went wrong.");
                    }
                },
                error: function () {
                    alert("Failed to update status.");
                }
            });
        });
    </script>
}