@model IEnumerable<FormRequest.Models.FormReqDb>

@{
    ViewData["Title"] = "All Requests";
    Layout = "~/Views/Shared/ITOlayout.cshtml";
}

<h2 class="page-title">All Requests</h2>

<table class="table table-bordered table-striped" id="requestTable">
    <thead class="purple-table-header">
        <tr>
            <th>Date</th>
            <th>Site</th>
            <th>Department</th>
            <th>Equipment</th>
            <th>Problem</th>
            <th>Status</th>
            <th>Confirm Movement Type</th>
            <th>Details</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var status = item.status?.Trim().ToLower();
            string statusClass = status switch
            {
                "accepted" => "table-accept",
                "reject" => "table-reject",
                "transit" => "table-transit",
                "onsite" => "table-onsite",
                _ => "table-pending"
            };

            <tr id="row-@item.Id">
                <td>@item.RequestDate.ToShortDateString()</td>
                <td>@item.Site</td>
                <td>@item.Department</td>
                <td>@item.EquipmentType</td>
                <td>@item.ProblemDescription</td>
                <td class="@statusClass status-cell" data-id="@item.Id">@item.status</td>
                <td>
                    @if (status == "transit" || status == "onsite")
                    {
                        <button class="btn btn-sm btn-success action-btn" data-id="@item.Id" data-action="accept">Accept</button>
                        <button class="btn btn-sm btn-danger action-btn" data-id="@item.Id" data-action="reject">Reject</button>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-purple">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).on("click", ".action-btn", function () {  //runs function after clicking button
            var id = $(this).data("id");  //each buton has data id+ data action
            var action = $(this).data("action");

            $.ajax({
                url: '@Url.Action("UpdateStatus", "FormReqDb")',
                type: 'POST',
                data: { id: id, actionType: action },
                success: function (response) {
                    if (response.success) {
                        var statusCell = $(".status-cell[data-id='" + id + "']");
                        statusCell.text(response.newStatus);
                        statusCell.removeClass().addClass("status-cell table-updated").text(response.newStatus);

                        // Optionally disable buttons after action
                        $("#row-" + id + " .action-btn").prop("disabled", true);
                    } else {
                        alert("Something went wrong.");
                    }
                },
                error: function () {
                    alert("Failed to update status.");
                }
            });
        });
    </script>
}



