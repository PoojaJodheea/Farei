﻿@using FormRequest.ViewModel
@model RequestViewModel
<head>
    <link rel="stylesheet" href="~/css/ITT.css" />
</head>
<partial name="Navbar"></partial>
<div class="container">
    <div>
        <h4>Details</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.FormReqDb.RequestDate)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.FormReqDb.RequestDate)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.FormReqDb.Site)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.FormReqDb.Site)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.FormReqDb.Department)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.FormReqDb.Department)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.FormReqDb.ResponsibleOfficer)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.FormReqDb.ResponsibleOfficer)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.FormReqDb.ContactPhone)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.FormReqDb.ContactPhone)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Inventory.SerialNumber)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Inventory.SerialNumber)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Inventory.EquipmentType)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Inventory.EquipmentType)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Inventory.EquipmentName)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Inventory.EquipmentName)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.FormReqDb.ProblemDescription)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.FormReqDb.ProblemDescription)
            </dd>


        </dl>
    </div>
    <div>
        @if (Model.FormReqDb.Pointer == 7)
        {

            <form asp-action="Report" method="post">
                <input value="@Model.FormReqDb.Id" name="id" type="hidden" />
                <input value="@Model.FormReqDb.SerialNumber" name="SerialNumber" type="hidden" />
                <div class="mb-3">
                    <input type="hidden" value="pending request"></input>
                    <label asp-for="ITTreport.Report"></label>
                    <textarea name="Remarks" class="form-control"></textarea>
                    <span class="text-danger"></span>
                </div>
                <input type="submit" value="Submit" class="btn btn-primary" />
            </form>
        }
        else if (Model.FormReqDb.Pointer == 5)
        {
            <form asp-action="Report" method="post">
                <input value="@Model.FormReqDb.Id" name="id" type="hidden" />

                <div class="mb-3">
                    <input type="hidden" value="pending request"></input>
                    <label></label>
                    <textarea name="Remarks" class="form-control"></textarea>
                    <span class="text-danger"></span>
                </div>
                <input type="submit" value="Submit" class="btn btn-primary" />
            </form>
        }
        else if (Model.FormReqDb.Pointer == 1)
        {
            <div class="mb-3">
                <form asp-action="ChangeStatus" method="post">
                    <input type="hidden" name="id" value="@Model.FormReqDb.Id"></input>
                    <input type="radio" class="form-check-input" name="Status" value=3><label class="form-check-label"> Onsite</label><br>
                    <input type="radio" class="form-check-input" name="Status" value=4><label class="form-check-label"> Transit</label><br>
                    <input type="submit" value="Submit" class="btn btn-primary" />
                </form>
            </div>
        }
    </div>
    <a asp-action="Index">Back to List</a>
</div>