﻿@using FormRequest.ViewModel
@model RequestViewModel
<head>
    <link rel="stylesheet" href="~/css/Registry.css" />
</head>
<partial name="Navbar"></partial>
<div class="container">
<div>
    <h4>Registry</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Registry.From)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Registry.From)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Registry.DateReceived)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Registry.DateReceived)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Registry.Remarks)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Registry.Remarks)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FormReqDb.Department)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FormReqDb.Department)
        </dd>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FormReqDb.remarks)
        </dd>
    </dl>

    <form asp-action="Arrived" method="post">
        <input type="hidden" name="id" value="@Model.Registry.RegistryId" />

        <input type="submit" value="Arrived" class="btn btn-sm primary btn-H">
    </form>

</div>



<div class="form-group">
    <form asp-action="SubmitRemarks" method="post" class="mt-4">
        <input type="hidden" name="id" value="@Model.FormReqDb.Id" />

        <div class="form-group">
            <label for="remarks">Remarks</label>
            <textarea name="remarks" id="remarks" class="form-control" rows="3">@Model.FormReqDb.remarks</textarea>
        </div>

        <button type="submit" class="btn btn-primary mt-2">Submit</button>
    </form>


    <a asp-action="Transit" class="btn btn-sm secondary btn-H">Back to List</a>
</div>

